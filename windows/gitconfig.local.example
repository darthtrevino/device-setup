# Template for ~/.gitconfig.local (machine/identity-specific; not committed).
# bootstrap.ps1 creates the file and fills in [user]; add org sections by hand.
# [user] is the default identity; repos with a github.com remote use gitconfig.darthtrevino instead.
[user]
	name = Your Name
	email = you@example.com

# Azure Repos via Git Credential Manager - one block per organization:
# [credential "azrepos:org/<organization>"]
# 	azureAuthority = https://login.microsoftonline.com/<tenant-id>
# 	username = you@example.com

# GitHub EMU orgs and GHE.com (*.ghe.com) credentials are generated by auth.ps1 into
# ~/.gitconfig.overrides; no manual sections needed.

# Repositories owned by another user (e.g. inside WSL):
# [safe]
# 	directory = //wsl.localhost/Ubuntu/home/<user>/<repo>
