# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
#
# OPTIONAL add-on: apps for physical hardware only (laptops/desktops you sit in front of).
# Skip it on remote machines (Microsoft Dev Box, cloud PCs, VMs) - e.g. the Windows App remote desktop
# client is what you use to reach those machines, not something they need themselves.
# Apply it after devbox\machine.dsc.winget.
#   Apply:  winget configure -f devbox\optional\physical.dsc.winget --accept-configuration-agreements
#   Check:  winget configure test -f devbox\optional\physical.dsc.winget

properties:
  configurationVersion: 0.2.0

  assertions:
    - resource: Microsoft.Windows.Developer/OsVersion
      directives: { description: "Require Windows 11", allowPrerelease: true }
      settings: { MinVersion: "10.0.22000" }

  resources:
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives: { description: "Windows App (remote desktop client for Dev Box / Cloud PC / AVD)", securityContext: elevated }
      settings: { id: "Microsoft.WindowsApp", source: winget }
