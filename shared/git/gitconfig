# Shared git settings for every platform -> ~/.gitconfig
#
# Nothing here names a path to a binary or an account. Those live in files kept out of the repo:
#   ~/.gitconfig.local        default identity, Azure Repos credentials, safe.directory entries
#                             (created by the platform bootstrap from gitconfig.local.example)
#   ~/.gitconfig.gh           \
#   ~/.gitconfig.darthtrevino  > generated by shared/git/auth.ps1; rerun it instead of editing
#   ~/.gitconfig.emu          /
#   ~/.gitconfig.overrides   /
[core]
	# Windows only; ignored elsewhere.
	longpaths = true

# Later includes win: gh credential helpers, default identity, then per-remote identities.
[include]
	path = ~/.gitconfig.gh
[include]
	path = ~/.gitconfig.local
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
	path = ~/.gitconfig.darthtrevino
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
	path = ~/.gitconfig.darthtrevino
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/**"]
	path = ~/.gitconfig.darthtrevino
# EMU org routing and GHE.com credentials. Must stay last.
[include]
	path = ~/.gitconfig.overrides
