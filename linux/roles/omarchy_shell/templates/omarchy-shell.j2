#!/usr/bin/env bash
# Managed by Ansible (roles/omarchy_shell). Local edits are overwritten.
#
# Upstream located the QML tree by resolving its own path, which only worked
# while the script lived inside a source checkout. The tree now has a fixed
# install location, so the path is baked in and this can be a plain copy on
# PATH rather than a symlink back into a repository.

set -euo pipefail

export OMARCHY_PATH="{{ omarchy_shell_install_dir }}"
export PATH="$OMARCHY_PATH/bin:$PATH"
shell_path="$OMARCHY_PATH/shell"

{% raw %}
case "${1:-start}" in
    start)
        exec qs -p "$shell_path" --no-duplicate
        ;;
    ipc)
        shift
        exec timeout 2s qs ipc -n -p "$shell_path" call -- "$@"
        ;;
    toggle-bar)
        state_file="$HOME/.local/state/omarchy/toggles/bar-off"
        mkdir -p "$(dirname "$state_file")"
        if [[ -e "$state_file" ]]; then
            rm -f "$state_file"
        else
            touch "$state_file"
        fi
        "$0" ipc omarchy.bar syncHidden >/dev/null 2>&1 || true
        ;;
    *)
        printf 'Usage: %s [start|ipc TARGET METHOD [ARGS...]|toggle-bar]\n' \
            "$(basename "$0")" >&2
        exit 2
        ;;
esac
{% endraw %}
