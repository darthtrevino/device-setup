#!/bin/bash

# omarchy:summary=Returns a list of all the available power profiles on the system.
# omarchy:args=[--active-state]

if [[ ${1:-} != "" && ${1:-} != "--active-state" ]]; then
  echo "Usage: omarchy-powerprofiles-list [--active-state]" >&2
  exit 1
fi

service=net.hadess.PowerProfiles
object=/net/hadess/PowerProfiles
interface=net.hadess.PowerProfiles

active=$(
  busctl --system get-property --json=short \
    "$service" "$object" "$interface" ActiveProfile 2>/dev/null |
    jq -r '.data // ""'
)

busctl --system get-property --json=short \
  "$service" "$object" "$interface" Profiles 2>/dev/null |
  jq -r --arg active "$active" --arg with_state "${1:+1}" '
    .data[]
    | .Profile.data as $profile
    | $profile + (
        if $with_state == ""
        then ""
        else "\t" + (if $profile == $active then "1" else "0" end)
        end
      )
  '
