#!/usr/bin/env bash

set -euo pipefail

no_osd=false
monitor=""

while (($# > 0)); do
    case "$1" in
        --no-osd)
            no_osd=true
            shift
            ;;
        --monitor)
            monitor=${2:-}
            shift 2
            ;;
        *)
            break
            ;;
    esac
done

if [[ -n "$monitor" && ! "$monitor" =~ ^(eDP|LVDS|DSI)- ]]; then
    exit 1
fi

brightness() {
    brightnessctl -m 2>/dev/null \
        | awk -F, 'NR == 1 { gsub("%", "", $4); print $4; found=1 }
            END { exit !found }'
}

if (($# == 0)); then
    brightness
    exit
fi

exec {lock_fd}>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-brightness-display.lock"
flock -n "$lock_fd" || exit 0

brightnessctl -e4 -n2 set "$1" >/dev/null
current=$(brightness)

if [[ "$no_osd" != "true" ]]; then
    notify-send \
        --hint="int:value:$current" \
        --hint=string:x-canonical-private-synchronous:brightness \
        "Brightness: $current%"
fi

printf '%s\n' "$current"
