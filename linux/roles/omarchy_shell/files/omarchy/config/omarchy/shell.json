{
  "version": 1,
  "bar": {
    "id": "omarchy.bar",
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators",
          "items": [
            "Dictation"
          ]
        },
        {
          "id": "omarchy.media"
        },
        {
          "id": "io.github.tyrichards.orthodox-daily"
        },
        {
          "id": "omarchy.clock",
          "format": "ddd MMM d  HH:mm",
          "formatAlt": "d MMMM yyyy"
        },
        {
          "id": "omarchy.weather",
          "unit": "imperial",
          "refreshMinutes": 15
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "josh2c.protonpass"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        }
      ]
    }
  },
  "plugins": []
}
