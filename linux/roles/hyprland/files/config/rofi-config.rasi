configuration {
    font: "JetBrainsMono Nerd Font 11";
    show-icons: true;
    icon-theme: "Adwaita";
    drun-display-format: "{name}";
    display-drun: "Applications";
    matching: "fuzzy";
}

* {
    background: #181818;
    surface: #242424;
    elevated: #303030;
    foreground: #eeeeee;
    muted: #929292;
    cyan: #7dcfff;
    green: #9ece6a;
    border: #464646;

    background-color: transparent;
    text-color: @foreground;
}

window {
    width: 640px;
    border: 1px;
    border-color: @border;
    border-radius: 14px;
    padding: 18px;
    background-color: @background;
}

mainbox {
    spacing: 14px;
    children: [ inputbar, message, listview ];
}

inputbar {
    padding: 12px 14px;
    spacing: 10px;
    border-radius: 9px;
    background-color: @surface;
    children: [ prompt, entry ];
}

prompt {
    text-color: @green;
}

entry {
    placeholder: "Type to search...";
    placeholder-color: @muted;
}

message {
    padding: 10px 12px;
    border-radius: 8px;
    background-color: @surface;
}

textbox {
    text-color: @muted;
}

listview {
    lines: 9;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 5px;
}

element {
    padding: 10px 12px;
    spacing: 12px;
    border-radius: 8px;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @elevated;
    text-color: @cyan;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
}
