-- Hyprland-run windowrule
hl.window_rule({
    name  = "move-hyprland-run",
    match = { class = "hyprland-run" },

    move  = "20 monitor_h-120",
    float = true,
})

hl.window_rule({
    name  = "float-okular",
    match = { class = "^org[.]kde[.]okular$" },
    float = true,
    size  = "1100 700",
})

local exec_onces = {
    "/usr/libexec/pam_kwallet_init",
    "hyprpaper",
    "voxtype daemon",
    "omarchy-shell start",
    "mako",
}

hl.on("hyprland.start", function()
    hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP GTK_THEME QT_QPA_PLATFORMTHEME")
    hl.exec_cmd("/usr/libexec/hyprpolkitagent")

    for _, cmd in ipairs(exec_onces) do
        hl.exec_cmd(cmd)
    end
end)
